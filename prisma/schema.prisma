generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(cuid())
  dailyCalorieLimit   Int?
  mealScheduleEnabled Boolean             @default(false)
  foodEntries         FoodEntry[]
  mealScheduleEntries MealScheduleEntry[]
}

model MealScheduleEntry {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeMinutes Int
  calories    Int

  @@unique([userId, timeMinutes])
}

model FoodEntry {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  calories Int
  eatenAt  DateTime @default(now())

  @@index([userId, eatenAt])
}
